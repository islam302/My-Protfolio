# -----------------------------------------------------------------------------
# Environment for docker-compose.yml and the API (apps/api). Copy to `.env`
# (git-ignored) and replace every CHANGE_ME. Never commit real values.
#
# Generate secrets:
#   openssl rand -hex 32         # passwords that end up inside a URL (DB, Redis)
#   openssl rand -base64 48      # IP_HASH_SECRET (any printable value, >= 32 chars)
# Use hex for POSTGRES_PASSWORD / REDIS_PASSWORD: base64 contains "/", "+" and
# "=", which break postgres:// and redis:// URLs unless percent-encoded.
#
# Production (Hetzner VM): this file lives at /srv/portfolio/shared/.env with
# chmod 600, outside every release dir (see infrastructure/deployment/DEPLOYMENT.md).
# Use different values per environment (dev / staging / prod).
# -----------------------------------------------------------------------------

# ---- API runtime (docs/API_CONTRACT.md "Configuration") ---------------------
# development | test | production. compose always runs the API with production.
NODE_ENV=production
# Port/interface the API listens on inside its container.
PORT=3000
HOST=0.0.0.0
# Full connection string. docker-compose builds it from the POSTGRES_* values
# below; set it explicitly when running the API outside compose.
# DATABASE_URL=postgres://portfolio:CHANGE_ME@127.0.0.1:5432/portfolio
DATABASE_POOL_MAX=10
# Per-statement timeout in ms (apps/api/src/config.js, default 10000).
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# Optional. When set, rate limits are shared across API instances via Redis.
# docker-compose builds it from REDIS_PASSWORD.
# REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# Exact public origin of the site (scheme + host [+ port]); used for the
# admin CSRF Origin check. Local compose: http://localhost:8080
PUBLIC_ORIGIN=http://localhost:8080
# Comma-separated allowlist, ONLY for split-origin development. Empty = CORS closed.
CORS_ORIGINS=
# Number of reverse-proxy hops in front of the API. 1 = nginx (compose).
# If a load balancer also sits in front of nginx AND nginx real_ip is NOT
# enabled, the client IP is still nginx's view — keep 1 and enable real_ip.
TRUST_PROXY=1
# HMAC key for storing IP addresses (never stored raw). >= 32 chars. Required in
# production. Rotating it makes old ip_hash values unlinkable (that's fine).
IP_HASH_SECRET=CHANGE_ME_openssl_rand_base64_48
# Secure flag on the session cookie (__Host-pf_session in production).
# Keep true in production. Browsers accept Secure cookies on http://localhost.
SESSION_COOKIE_SECURE=true
# Swagger UI at /api/docs. Keep false in production.
API_DOCS=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Database (postgres container) -------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=portfolio

# ---- Redis (rate-limit store) -------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# ---- Web build (build args of infrastructure/docker/web.Dockerfile) ----------
# Canonical site URL baked into canonical links / sitemap / OG tags.
SITE_URL=https://islambadran.com
# Where the contact form sends briefs. Same-origin path. Set it EMPTY
# (PUBLIC_API_URL=) to build the original API-less site.
PUBLIC_API_URL=/api

# ---- Published port of the web container --------------------------------------
# Bind address; 127.0.0.1 keeps the stack private to this machine.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# ---- Production (docker-compose.prod.yml) ------------------------------------------
# PUBLIC_ORIGIN above MUST be https://<domain> in production (required by the overlay).
# Host bind addresses for 80/443 (default all interfaces).
# WEB_HTTP_BIND=0.0.0.0
# WEB_HTTPS_BIND=0.0.0.0
# Directory with certs/ and acme/ (exported by remote-deploy.sh).
# PORTFOLIO_SHARED=/srv/portfolio/shared

# ---- Images ------------------------------------------------------------------------
# Set by remote-deploy.sh from the deploy workflow, pinned by digest, e.g.
# API_IMAGE=ghcr.io/owner/portfolio-api@sha256:<64 hex>
# WEB_IMAGE=ghcr.io/owner/portfolio-web@sha256:<64 hex>
# Locally they default to portfolio-api:local / portfolio-web:local (built by compose).

# ---- One-off: first admin account (only when running the admin CLI) -----------
# Pass these to `docker compose run` with -e, don't keep them in .env:
#   docker compose run --rm -e ADMIN_EMAIL=you@example.com -e ADMIN_PASSWORD api node src/cli/create-admin.js
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Tests (CI) -----------------------------------------------------------------
# Real Postgres for API integration tests; unset = PGlite in-process.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/portfolio_test
